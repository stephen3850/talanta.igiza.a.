# ==============================================================================
# TALANTA STADIUM SMART DIGITAL INFRASTRUCTURE
# ST-Tech ICT Consultants - Production Environment Configuration Template
# ==============================================================================

# 1. DATABASE CONFIGURATION (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL="postgresql://postgres:your_secure_db_password@localhost:5432/talanta_stadium_db?schema=public"

# 2. APPLICATION DOMAIN & URLS
# Canonical production URL (Must use HTTPS in production)
NEXT_PUBLIC_APP_URL="https://talanta.sttech.co.ke"
NODE_ENV="production" # "development" | "staging" | "production"

# 3. SECURITY & CRYPTOGRAPHIC SECRETS
# Generate strong 64-character random strings for production keys
JWT_SECRET=""
# Base64-encoded random 32-byte key used only to encrypt TOTP seeds.
MFA_ENCRYPTION_KEY_B64=""
IAM_ENFORCE_MFA_FOR_PRIVILEGED="false"
# Password reset mail is sent through Resend; client secrets are never stored in the database.
RESEND_API_KEY=""
IAM_PASSWORD_RESET_FROM_EMAIL="security@example.invalid"
ACCESS_CONTROL_AUDIT_KEY=""
EMERGENCY_COMMS_AUDIT_KEY=""
SOC_EVENT_HASH_KEY=""
# Separate base64-encoded random 32-byte key for encrypted privacy-request contact details.
# Re-encrypt existing values before changing this key.
GOVERNANCE_ENCRYPTION_KEY_B64=""
# Separate high-entropy secret (at least 32 characters) used to HMAC subject references; preserve it for stable lookups.
GOVERNANCE_SUBJECT_HASH_KEY=""
TICKET_SIGNING_SECRET="generate_strong_random_64_char_ticket_hmac_secret"
INITIAL_ADMIN_PASSWORD=""

# 4. SAFARICOM M-PESA DARAJA API CONFIGURATION
# Set MPESA_ENVIRONMENT to "production" when live Daraja credentials are issued
MPESA_ENVIRONMENT="sandbox" # "sandbox" | "production"
MPESA_CONSUMER_KEY="your_daraja_consumer_key"
MPESA_CONSUMER_SECRET="your_daraja_consumer_secret"
MPESA_SHORTCODE="174379" # Production Paybill or Till Number
MPESA_PASSKEY="bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919"
MPESA_CALLBACK_URL="https://talanta.sttech.co.ke/api/payments/callback"

# 5. EMAIL & NOTIFICATION GATEWAY (SMTP / Resend)
SMTP_HOST="smtp.resend.com"
SMTP_PORT=587
SMTP_USER="resend"
SMTP_PASS="re_your_resend_smtp_api_key"
NOTIFICATION_FROM_EMAIL="tickets@sttech.co.ke"

# 6. SYSTEM BACKUP CONFIGURATION
BACKUP_RETENTION_DAYS=30
BACKUP_DIR="D:\\TalantaProtectedBackups"
# Base64-encoded random 32-byte key from a secrets manager; never commit or reuse JWT_SECRET.
BACKUP_ENCRYPTION_KEY_B64=""
# Temporary plaintext restore files require an encrypted, access-restricted ephemeral volume.
DR_RESTORE_TMPDIR=""
# Private evidence store, outside the application repository and web root.
HARDWARE_EVIDENCE_DIR="D:\\TalantaPrivateEvidence"
