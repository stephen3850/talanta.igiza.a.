  @@index([currentStage, createdAt])
  @@map("procurement_requests")
}

model ProcurementItem {
  id                 String   @id @default(uuid())
  requestId          String
  itemName           String
  category           String
  quantity           Int
  unitPrice          Float
  estimatedCost      Float
  specifications     String?  @db.Text
  receivedQuantity   Int      @default(0)

  procurementRequest ProcurementRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("procurement_items")
}

model ProcurementApprovalLog {
  id                 String   @id @default(uuid())
  requestId          String
  stage              String
  approverId         String
  action             String
  comments           String?  @db.Text
  createdAt          DateTime @default(now())

  procurementRequest ProcurementRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, stage])
  @@map("procurement_approval_logs")
}

model PurchaseOrder {
  id                   String   @id @default(uuid())
  poNumber             String   @unique
  requestId            String?
  supplierId           String
  facilityId           String
  totalAmount          Float
  currency             String   @default("KES")
  status               String   @default("ISSUED")
  expectedDeliveryDate DateTime?
  notes                String?  @db.Text
  createdById          String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  supplier             Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  procurementRequest   ProcurementRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  facility             Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  receivingRecords     EquipmentReceivingRecord[]
  hardwareAssets       HardwareAsset[]

  @@index([facilityId, status, createdAt])
  @@index([supplierId, status])
  @@map("purchase_orders")
}

model SupplierContract {
  id               String   @id @default(uuid())
  contractNumber   String   @unique
  supplierId       String
  facilityId       String?
  title            String
  description      String?  @db.Text
  contractValue    Float
  currency         String   @default("KES")
  startDate        DateTime
  expiryDate       DateTime
  renewalDate      DateTime?
  noticePeriodDays Int      @default(30)
  status           String   @default("ACTIVE")
  documentUrl      String?
  documentName     String?
  createdById      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  supplier         Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  facility         Facility? @relation(fields: [facilityId], references: [id], onDelete: SetNull)

  @@index([supplierId, status, expiryDate])
  @@index([expiryDate, status])
  @@map("supplier_contracts")
}

model EquipmentReceivingRecord {
  id               String   @id @default(uuid())
  receivingRef     String   @unique
  purchaseOrderId  String
  receivedById     String
  inspectionStatus String   @default("PASSED")
  inspectionNotes  String?  @db.Text
  receivedDate     DateTime @default(now())
  createdAt        DateTime @default(now())

  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  hardwareAssets   HardwareAsset[]

  @@index([purchaseOrderId, receivedDate])
  @@map("equipment_receiving_records")
}

model ProcurementAuditLog {
  id         String   @id @default(uuid())
  actorId    String
  facilityId String?
  action     String
  entityType String
  entityId   String?
  details    String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, createdAt])
  @@index([facilityId, createdAt])
  @@map("procurement_audit_logs")
}

model HelpdeskTicket {
  id                    String   @id @default(uuid())
  ticketNumber          String   @unique
  category              String
  title                 String
  description           String   @db.Text
  priority              String   @default("MEDIUM")
  facilityId            String
  department            String?
  status                String   @default("NEW")
  createdById           String
  creatorEmail          String?
  assignedTechnicianId  String?
  assignedTechnicianName String?
  equipmentInvolved     String?
  resolutionNotes       String?  @db.Text
  resolutionArticleId   String?
  responseTargetHours   Int      @default(4)
  resolutionTargetHours Int      @default(24)
  firstRespondedAt      DateTime?
  resolvedAt            DateTime?
  closedAt              DateTime?
  isEscalated           Boolean  @default(false)
  escalationReason      String?  @db.Text
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  facility              Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  knowledgeArticle      HelpdeskKnowledgeArticle? @relation(fields: [resolutionArticleId], references: [id], onDelete: SetNull)
  workLogs              HelpdeskWorkLog[]
  attachments           HelpdeskAttachment[]

  @@index([facilityId, status, priority])
  @@index([category, status])
  @@index([assignedTechnicianId, status])
  @@index([createdById, createdAt])
  @@map("helpdesk_tickets")
}

model HelpdeskWorkLog {
  id               String   @id @default(uuid())
  ticketId         String
  technicianId     String
  technicianName   String?
  workSummary      String   @db.Text
  equipmentAction  String?
  timeSpentMinutes Int      @default(15)
  createdAt        DateTime @default(now())

  ticket           HelpdeskTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("helpdesk_work_logs")
}

model HelpdeskKnowledgeArticle {
  id           String   @id @default(uuid())
  articleRef   String   @unique
  title        String
  category     String
  summary      String   @db.Text
  solutionBody String   @db.Text
  tags         String?
  viewCount    Int      @default(0)
  authorId     String
  isPublished  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tickets      HelpdeskTicket[]

  @@index([category, isPublished])
  @@map("helpdesk_knowledge_articles")
}

model HelpdeskAttachment {
  id           String   @id @default(uuid())
  ticketId     String
  fileName     String
  fileUrl      String
  fileType     String?
  uploadedById String
  createdAt    DateTime @default(now())

  ticket       HelpdeskTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("helpdesk_attachments")
}

model HelpdeskSlaConfig {
  id                    String   @id @default(uuid())
  priority              String   @unique
  responseTargetHours   Int
  resolutionTargetHours Int
  updatedById           String
  updatedAt             DateTime @updatedAt

  @@map("helpdesk_sla_configs")
}

model HelpdeskAuditLog {
  id         String   @id @default(uuid())
  actorId    String
  facilityId String?
  action     String
  entityType String
  entityId   String?
  details    String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, createdAt])
  @@index([facilityId, createdAt])
  @@map("helpdesk_audit_logs")
}

model ExecutiveKpiConfig {
  id                      String   @id @default(uuid())
  kpiKey                  String   @unique
  label                   String
  targetValue             Float
  unit                    String   @default("%")
  category                String   @default("OPERATIONAL")
  updatedById             String
  updatedAt               DateTime @updatedAt

  @@map("executive_kpi_configs")
}

model ExecutiveAuditLog {
  id         String   @id @default(uuid())
  actorId    String
  facilityId String?
  action     String
  entityType String
  entityId   String?
  details    String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, createdAt])
  @@index([facilityId, createdAt])
  @@map("executive_audit_logs")
}
