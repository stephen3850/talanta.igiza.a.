// TALANTA STADIUM SMART DIGITAL INFRASTRUCTURE SCHEMA
// ST-Tech ICT Consultants
// PostgreSQL Database Schema Definition

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  STEWARD
  STAFF_MEMBER
  CONTRACTOR
  MAINTENANCE_TECHNICIAN
  GATE_OPERATOR
  SECURITY_SUPERVISOR
  FINANCE_OFFICER
  TICKETING_OFFICER
  VENUE_MANAGER
  STADIUM_ADMINISTRATOR
  OPERATIONS_MANAGER
  SYSTEM_ADMIN
  PLATFORM_ADMINISTRATOR
}

enum FacilityType {
  STADIUM
  TRAINING_FACILITY
  PARKING_FACILITY
  SPORTS_FACILITY
  OTHER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CONFIRMED
  PROPOSED
  AWAITING_CONFIRMATION
  CANDIDATE_VENUE
  CANCELLED
  COMPLETED
  POSTPONED
  ARCHIVED
}

enum BookingStatus {
  PENDING
  AWAITING_PAYMENT
  CONFIRMED
  EXPIRED
  CANCELLED
  REFUNDED
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum TicketStatus {
  ISSUED
  VALIDATED
  EXPIRED
  REVOKED
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCESSFUL
  FAILED
  CANCELLED
  EXPIRED
  REVERSED
}

enum AccreditationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
  EXPIRED
}

enum StaffCategory {
  STADIUM_EMPLOYEE
  SECURITY
  EVENT_ORGANIZER
  CONTRACTOR
  VENDOR
  TECHNICAL
  MEDICAL_EMERGENCY
  OTHER
}

enum IoTDeviceStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
  DISABLED
}

enum IoTCategory {
  ENVIRONMENTAL
  TEMPERATURE_HUMIDITY
  AIR_QUALITY
  ENERGY_METER
  WATER_MONITORING
  OCCUPANCY
  EQUIPMENT_HVAC
  ACCESS_CONTROL
  OTHER
}

model Facility {
  id                    String       @id @default(uuid())
  facilityCode          String       @unique
  name                  String
  description           String?      @db.Text
  type                  FacilityType
  address               String?
  city                  String?
  country               String?
  timezone              String       @default("Africa/Nairobi")
  status                String       @default("ACTIVE")
  operationalInfo       String?      @db.Text
  isDevelopmentSample   Boolean      @default(false)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  memberships           FacilityMembership[]
  events                Event[]
  staffAccreditations   StaffAccreditation[]
  iotDevices            IoTDevice[]
  hardwareAssets        HardwareAsset[]
  cameras               Camera[]
  networkDevices        NetworkInfrastructureDevice[]
  vmsIntegrations       VmsIntegration[]
  wirelessIntegrations  WirelessControllerIntegration[]
  accessIntegrations    AccessControlIntegration[]
  emergencyIntegrations EmergencyCommunicationIntegration[]
  wifiPolicies          GuestWifiPolicy[]
  networkSegments       NetworkSegment[]
  wifiUsageAggregates   WifiUsageAggregate[]
  accessControlPoints   AccessControlPoint[]
  securityEvents        SecurityEvent[]
  securityAlerts        SecurityAlert[]
  securityIncidents     SecurityIncident[]
  emergencyMessages     EmergencyCommunicationMessage[]
  revenueRecords       RevenueRecord[]
  financialAdjustments FinancialAdjustment[]
  reconciliationBatches ReconciliationBatch[]
  procurementRequests  ProcurementRequest[]
  purchaseOrders       PurchaseOrder[]
  supplierContracts    SupplierContract[]
  helpdeskTickets      HelpdeskTicket[]

  @@index([type, status])
  @@map("facilities")
}

model FacilityMembership {
  id          String   @id @default(uuid())
  facilityId  String
  userId      String
  role        String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  facility    Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([facilityId, userId])
  @@index([userId, isActive])
  @@index([facilityId, role, isActive])
  @@map("facility_memberships")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  fullName      String
  phoneNumber   String?
  role          Role           @default(CUSTOMER)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  orders        Order[]
  bookings      Booking[]
  tickets       Ticket[]
  auditLogs     AuditLog[]
  facilityMemberships FacilityMembership[]
  iamSessions   IamSession[]
  mfaCredential MfaCredential?
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model IamSession {
  id            String    @id @default(uuid())
  userId        String
  tokenHash     String    @unique
  userAgent     String?
  ipAddressHash String?
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt])
  @@map("iam_sessions")
}

model MfaCredential {
  id                String    @id @default(uuid())
  userId            String    @unique
  secretCiphertext  String
  enabledAt         DateTime?
  lastTotpCounter   BigInt    @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  recoveryCodes     MfaRecoveryCode[]

  @@map("mfa_credentials")
}

model MfaRecoveryCode {
  id            String    @id @default(uuid())
  credentialId  String
  codeHash      String    @unique
  consumedAt    DateTime?
  createdAt     DateTime  @default(now())

  credential    MfaCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@index([credentialId, consumedAt])
  @@map("mfa_recovery_codes")
}

model PasswordResetToken {
  id          String    @id @default(uuid())
  userId      String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt, expiresAt])
  @@map("password_reset_tokens")
}

model IdentityProvider {
  id             String   @id @default(uuid())
  providerKey    String   @unique
  displayName    String
  protocol       String
  issuerUrl      String
  clientId       String
  secretReference String
  scopes         String   @default("openid profile email")
  status         String   @default("PENDING_CONFIGURATION")
  configuredById String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([protocol, status])
  @@map("identity_providers")
}

model Event {
  id               String           @id @default(uuid())
  eventCode        String           @unique
  title            String
  slug             String           @unique
  description      String?          @db.Text
  category         String
  image            String?
  startDate        DateTime
  endDate          DateTime
  venue            String           @default("Main Bowl")
  organizer        String?          @default("Ministry of Sports / FKF")
  contactInfo      String?
  ticketSalesStart DateTime?
  ticketSalesEnd   DateTime?
  status           EventStatus      @default(DRAFT)
  featured         Boolean          @default(false)
  createdById      String?
  facilityId       String       @default("FACILITY-TALANTA-STADIUM")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  facility         Facility         @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  categories       TicketCategory[]
  orders           Order[]
  bookings         Booking[]
  tickets          Ticket[]
  revenueRecords   RevenueRecord[]
  financialAdjustments FinancialAdjustment[]

  @@index([facilityId, status, startDate])
  @@map("events")
}

model TicketCategory {
  id             String        @id @default(uuid())
  eventId        String
  categoryName   String
  description    String?
  price          Float
  totalCapacity  Int
  availableSeats Int
  maxPurchaseQty Int           @default(6)
  holdMinutes    Int           @default(10)
  salesStart     DateTime?
  salesEnd       DateTime?
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  event          Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bookingItems   BookingItem[]
  tickets        Ticket[]

  @@map("ticket_categories")
}

model Booking {
  id             String        @id @default(uuid())
  bookingRef     String        @unique
  userId         String
  userEmail      String
  userName       String
  eventId        String
  totalAmount    Float
  currency       String        @default("KES")
  bookingStatus  BookingStatus @default(PENDING)
  mpesaReceipt   String?
  mpesaPhone     String?
  expiresAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user           User          @relation(fields: [userId], references: [id])
  event          Event         @relation(fields: [eventId], references: [id])
  bookingItems   BookingItem[]
  tickets        Ticket[]
  payments       Payment[]

  @@map("bookings")
}

model BookingItem {
  id             String         @id @default(uuid())
  bookingId      String
  categoryId     String
  categoryName   String
  quantity       Int
  unitPrice      Float
  subtotal       Float

  booking        Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  category       TicketCategory @relation(fields: [categoryId], references: [id])

  @@map("booking_items")
}

model Order {
  id             String      @id @default(uuid())
  orderRef       String      @unique
  userId         String
  eventId        String
  totalAmount    Float
  currency       String      @default("KES")
  status         OrderStatus @default(DRAFT)
  mpesaReceipt   String?
  mpesaPhone     String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user           User        @relation(fields: [userId], references: [id])
  event          Event       @relation(fields: [eventId], references: [id])
  tickets        Ticket[]
  payments       Payment[]

  @@map("orders")
}

model Ticket {
  id             String         @id @default(uuid())
  ticketNumber   String         @unique
  bookingId      String?
  orderId        String?
  eventId        String
  categoryId     String
  userId         String
  seatNumber     String?
  qrToken        String         @db.Text
  status         TicketStatus   @default(ISSUED)
  gateValidated  String?
  validatedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  booking        Booking?       @relation(fields: [bookingId], references: [id])
  order          Order?         @relation(fields: [orderId], references: [id])
  event          Event          @relation(fields: [eventId], references: [id])
  category       TicketCategory @relation(fields: [categoryId], references: [id])
  user           User           @relation(fields: [userId], references: [id])
  gateLogs       GateLog[]

  @@map("tickets")
}

model Payment {
  id                String           @id @default(uuid())
  paymentRef        String           @unique
  bookingId         String?
  orderId           String?
  amount            Float
  currency          String           @default("KES")
  provider          String           @default("M-PESA")
  phoneNumber       String?
  merchantRequestId String?
  checkoutRequestId String?          @unique
  mpesaReceipt      String?
  status            PaymentStatus    @default(INITIATED)
  rawCallback       String?          @db.Text
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  booking           Booking?         @relation(fields: [bookingId], references: [id])
  order             Order?           @relation(fields: [orderId], references: [id])
  attempts          PaymentAttempt[]
  reconciliation    PaymentReconciliation?
  statementLine     ProviderStatementLine?
  refundRequests    RefundRequest[]

  @@map("payments")
}

model PaymentAttempt {
  id                  String   @id @default(uuid())
  paymentId           String
  merchantRequestId   String?
  checkoutRequestId   String?
  responseCode        String?
  responseDescription String?
  customerMessage     String?
  createdAt           DateTime @default(now())

  payment             Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("payment_attempts")
}

model GateLog {
  id               String       @id @default(uuid())
  ticketId         String?
  ticketNumber     String
  gateId           String       // e.g. "GATE-A-01"
  deviceId         String       // e.g. "SCANNER-MOB-04"
  validationStatus String       // APPROVED, REJECTED, EXPIRED, DUPLICATE
  failureReason    String?
  scannedAt        DateTime     @default(now())

  ticket           Ticket?      @relation(fields: [ticketId], references: [id])

  @@map("gate_logs")
}

model StaffAccreditation {
  id              String              @id @default(uuid())
  accreditationNo String              @unique
  fullName        String
  email           String?
  phoneNumber     String?
  idNumber        String
  organisation    String
  department      String              @default("Operations")
  roleTitle       String
  category        StaffCategory       @default(STADIUM_EMPLOYEE)
  zonePermissions String
  validFrom       DateTime
  validUntil      DateTime
  status          AccreditationStatus @default(APPROVED)
  facilityId      String       @default("FACILITY-TALANTA-STADIUM")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  facility        Facility            @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  @@index([facilityId, status, validUntil])
  @@map("staff_accreditations")
}

model IoTDevice {
  id           String          @id @default(uuid())
  deviceId     String          @unique
  name         String
  category     IoTCategory     @default(ENVIRONMENTAL)
  manufacturer String?         @default("Siemens / Schneider")
  model        String?
  serialNumber String?
  zoneLocation String
  gatewayId    String?         @default("GW-MQTT-MAIN-01")
  protocol     String          @default("MQTT")
  status       IoTDeviceStatus @default(ONLINE)
  apiKey       String?
  installedAt  DateTime        @default(now())
  lastSeenAt   DateTime        @default(now())
  facilityId   String       @default("FACILITY-TALANTA-STADIUM")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  facility      Facility        @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  telemetries   IoTTelemetry[]
  alerts        IoTAlert[]
  hardwareAsset HardwareAsset?

  @@index([facilityId, status, category])
  @@map("iot_devices")
}

model IoTTelemetry {
  id               String    @id @default(uuid())
  deviceId         String
  measurementType  String
  measurementValue Float
  unit             String
  isSimulated      Boolean   @default(true)
  timestamp        DateTime  @default(now())

  device           IoTDevice @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)

  @@map("iot_telemetries")
}

model IoTAlert {
  id             String    @id @default(uuid())
  deviceId       String
  severity       String
  title          String
  message        String
  thresholdValue Float?
  actualValue    Float?
  acknowledged   Boolean   @default(false)
  createdAt      DateTime  @default(now())

  device         IoTDevice @relation(fields: [deviceId], references: [deviceId], onDelete: Cascade)

  @@map("iot_alerts")
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String?
  userEmail   String?
  action      String
  entityType  String
  entityId    String?
  ipAddress   String?
  userAgent   String?
  details     String?  @db.Text
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model SystemConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String   @db.Text
  description String?
  updatedAt   DateTime @updatedAt

  @@map("system_config")
}

enum CameraZone {
  BOWL
  CONCOURSE
  ENTRANCE
  EXIT
  PARKING
  RESTRICTED
  OTHER
}

enum CameraInstallationStatus {
  PLANNED
  INSTALLED
  DECOMMISSIONED
}

enum CameraOperationalStatus {
  UNKNOWN
  ONLINE
  OFFLINE
  DEGRADED
}

model Camera {
  id                      String                   @id @default(uuid())
  cameraId                String                   @unique
  name                    String
  zone                    CameraZone
  locationDescription     String
  cameraType              String
  manufacturer            String?
  model                   String?
  installationStatus      CameraInstallationStatus @default(PLANNED)
  operationalStatus       CameraOperationalStatus  @default(UNKNOWN)
  statusSource            String                   @default("UNVERIFIED")
  lastStatusAt            DateTime?
  privacyMaskingSupported Boolean                  @default(false)
  privacyMaskingEnabled   Boolean                  @default(false)
  isSimulated             Boolean                  @default(false)
  facilityId              String                   @default("FACILITY-TALANTA-STADIUM")
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  facility                Facility                 @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  events                  CameraEventMetadata[]
  accessLogs              CameraAccessLog[]

  @@index([zone, installationStatus])
  @@index([facilityId, operationalStatus])
  @@map("camera_records")
}

model VmsIntegration {
  id               String   @id @default(uuid())
  providerName     String
  protocol         String
  endpointUrl      String
  secretReference  String?
  connectionStatus String   @default("UNVERIFIED")
  isSimulated      Boolean  @default(false)
  createdById      String?
  createdByEmail   String?
  facilityId       String   @default("FACILITY-TALANTA-STADIUM")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  facility         Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  @@index([facilityId, connectionStatus])
  @@map("camera_vms_integrations")
}

model CameraEventMetadata {
  id                String   @id @default(uuid())
  cameraId          String
  eventType         String
  summary           String
  occurredAt        DateTime
  incidentReference String
  vmsRecordingUrl   String?
  isSimulated       Boolean  @default(false)
  createdById       String?
  createdByEmail    String?
  createdAt         DateTime @default(now())

  camera            Camera   @relation(fields: [cameraId], references: [cameraId], onDelete: Cascade)

  @@index([occurredAt])
  @@index([incidentReference])
  @@map("camera_event_metadata")
}

model CameraAccessLog {
  id        String   @id @default(uuid())
  userId    String?
  userEmail String
  action    String
  cameraId  String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  camera    Camera?  @relation(fields: [cameraId], references: [cameraId], onDelete: SetNull)

  @@index([userEmail, createdAt])
  @@index([cameraId, createdAt])
  @@map("camera_access_logs")
}

model NetworkInfrastructureDevice {
  id                String   @id @default(uuid())
  deviceId          String   @unique
  name              String
  category          String
  zone              String
  manufacturer      String?
  model             String?
  operationalStatus String   @default("UNKNOWN")
  statusSource      String   @default("UNVERIFIED")
  lastStatusAt      DateTime?
  isSimulated       Boolean  @default(false)
  facilityId        String       @default("FACILITY-TALANTA-STADIUM")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  facility          Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  @@index([zone, category])
  @@index([facilityId, category, operationalStatus])
  @@map("network_infrastructure_devices")
}

model WirelessControllerIntegration {
  id               String   @id @default(uuid())
  providerName     String
  protocol         String
  endpointUrl      String
  secretReference  String?
  connectionStatus String   @default("UNVERIFIED")
  isSimulated      Boolean  @default(false)
  createdById      String?
  createdByEmail   String?
  facilityId       String   @default("FACILITY-TALANTA-STADIUM")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  facility         Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  @@index([facilityId, connectionStatus])
  @@map("wireless_controller_integrations")
}

model GuestWifiPolicy {
  id                    String   @id @default(uuid())
  ssid                  String
  captivePortalProvider String?
  bandwidthMbps         Int
  sessionMinutes        Int
  idleTimeoutMinutes    Int
  maxDevicesPerSession  Int
  status                String   @default("PENDING_APPROVAL")
  createdById           String?
  createdByEmail        String?
  isSimulated           Boolean  @default(false)
  facilityId            String       @default("FACILITY-TALANTA-STADIUM")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  facility              Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([facilityId, status])
  @@map("guest_wifi_policies")
}

model NetworkSegment {
  id          String   @id @default(uuid())
  segmentKey  String
  name        String
  purpose     String
  status      String   @default("PROPOSED")
  isSimulated Boolean  @default(false)
  facilityId  String   @default("FACILITY-TALANTA-STADIUM")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  facility    Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  @@unique([facilityId, segmentKey])
  @@index([facilityId, status])
  @@map("network_segments")
}

model WifiUsageAggregate {
  id                String   @id @default(uuid())
  windowStart       DateTime
  windowMinutes     Int
  connectedDevices Int
  sessions          Int
  totalDataMb       Float
  source            String   @default("SIMULATED")
  isSimulated       Boolean  @default(true)
  facilityId        String       @default("FACILITY-TALANTA-STADIUM")
  createdAt         DateTime @default(now())

  facility          Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  @@index([windowStart])
  @@index([facilityId, windowStart])
  @@map("wifi_usage_aggregates")
}

model NetworkAccessLog {
  id        String   @id @default(uuid())
  userId    String?
  userEmail String
  action    String
  entityId  String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userEmail, createdAt])
  @@map("network_access_logs")
}

model AccessControlPoint {
  id                String   @id @default(uuid())
  pointId           String   @unique
  name              String
  zone              String
  location          String
  hardwareType      String
  manufacturer      String?
  model             String?
  installationStatus String  @default("PLANNED")
  operationalStatus String   @default("UNKNOWN")
  integrationStatus String   @default("UNVERIFIED")
  statusSource      String   @default("UNVERIFIED")
  isEmergencyExit   Boolean  @default(false)
  isSimulated       Boolean  @default(false)
  lastStatusAt      DateTime?
  facilityId        String       @default("FACILITY-TALANTA-STADIUM")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  facility          Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict)
  permissions       AccessControlPermission[]
  events            AccessControlEvent[]
  alerts            AccessControlAlert[]

  @@index([zone, installationStatus])
  @@index([facilityId, operationalStatus])
  @@map("access_control_points")
}

model AccessControlPermission {
  id                String   @id @default(uuid())
  pointId           String
  targetType        String
  targetId          String
  groupName         String?
  zone              String
  validFrom         DateTime
  expiresAt         DateTime
  revokedAt         DateTime?
  reason            String?
  createdById       String
  createdByEmail    String?
  isSimulated       Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  point             AccessControlPoint @relation(fields: [pointId], references: [pointId], onDelete: Cascade)
  events            AccessControlEvent[]

  @@index([pointId, validFrom, expiresAt, revokedAt])
  @@index([targetType, targetId])
  @@map("access_control_permissions")
}

model AccessControlIntegration {
  id               String   @id @default(uuid())
  providerName     String
  protocol         String
  endpointUrl      String
  secretReference  String?
  connectionStatus String   @default("UNVERIFIED")
  isSimulated      Boolean  @default(false)
  createdById      String?
  createdByEmail   String?
  facilityId       String   @default("FACILITY-TALANTA-STADIUM")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  facility         Facility @relation(fields: [facilityId], references: [id], onDelete: Restrict)

  @@index([facilityId, connectionStatus])
  @@map("access_control_integrations")
}

model AccessControlEvent {
  id                String   @id @default(uuid())
  eventRef          String   @unique
